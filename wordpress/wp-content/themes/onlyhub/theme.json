{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug": "ink", "name": "Ink", "color": "#07111f"},
        {"slug": "surface", "name": "Surface", "color": "#102033"},
        {"slug": "sky", "name": "Sky", "color": "#38bdf8"},
        {"slug": "gold", "name": "Gold", "color": "#fbbf24"},
        {"slug": "white", "name": "White", "color": "#ffffff"},
        {"slug": "muted", "name": "Muted", "color": "#a9b6c8"}
      ]
    },
    "spacing": {
      "spacingSizes": [
        {"slug": "20", "size": "0.5rem", "name": "XS"},
        {"slug": "30", "size": "1rem", "name": "S"},
        {"slug": "40", "size": "1.5rem", "name": "M"},
        {"slug": "50", "size": "2.5rem", "name": "L"},
        {"slug": "60", "size": "4rem", "name": "XL"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {"slug": "system", "name": "System", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"}
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.875rem", "name": "Small"},
        {"slug": "medium", "size": "1rem", "name": "Medium"},
        {"slug": "large", "size": "1.5rem", "name": "Large"},
        {"slug": "x-large", "size": "clamp(2rem, 5vw, 4.5rem)", "name": "Display"}
      ]
    }
  },
  "styles": {
    "color": {"background": "#07111f", "text": "#ffffff"},
    "typography": {"fontFamily": "var(--wp--preset--font-family--system)", "lineHeight": "1.6"},
    "elements": {
      "link": {"color": {"text": "#38bdf8"}},
      "button": {
        "border": {"radius": "999px"},
        "color": {"background": "#38bdf8", "text": "#07111f"},
        "typography": {"fontWeight": "700"}
      }
    }
  }
}
